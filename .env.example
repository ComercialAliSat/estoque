# Copie para .env.local. Nunca commite segredos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# demo = dados simulados no navegador (padrao); supabase = banco real
VITE_ESTOQUE_DATA_MODE=demo
VITE_ESTOQUE_BASE_PATH=/app
# Integracoes: mock (padrao) ou real
VITE_INTEGRATION_CRM=mock
VITE_INTEGRATION_ARGOS=mock
VITE_INTEGRATION_NFE=mock
VITE_INTEGRATION_CORREIOS=mock
